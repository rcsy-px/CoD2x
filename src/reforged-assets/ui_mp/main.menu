 name "rfg_launcher_join" rect 0 0 640 480 4 4 fullScreen 0 popup
 focusColor 1 .84 .42 1
 onESC { close rfg_launcher_join; }
 itemDef { decoration visible 1 rect 0.000 0.000 640.000 480.000 4 4 style WINDOW_STYLE_SHADER background "white" forecolor 0 0 0 .78 }
 itemDef { decoration visible 1 rect 137.799 142.827 364.402 188.735 4 4 style WINDOW_STYLE_SHADER background "white" forecolor .035 .035 .027 1 }
 itemDef { decoration visible 1 rect 137.799 142.827 364.402 1.020 4 4 style WINDOW_STYLE_SHADER background "white" forecolor .85 .66 .30 1 }
 itemDef { decoration visible 1 rect 157.703 159.150 344.498 15.303 4 4 text "JOIN THROUGH THE LAUNCHER" textfont UI_FONT_NORMAL textscale .34 textaligny 12 forecolor .93 .78 .44 1 textstyle ITEM_TEXTSTYLE_SHADOWED }
 itemDef { decoration visible 1 rect 157.703 198.937 336.842 15.303 4 4 text "The launcher provides a fresh, verified connection." textfont UI_FONT_NORMAL textscale .24 textaligny 12 forecolor .88 .86 .79 1 textstyle ITEM_TEXTSTYLE_SHADOWED }
 itemDef { decoration visible 1 rect 157.703 219.341 336.842 15.303 4 4 text "Return to the launcher, then press PLAY to join." textfont UI_FONT_NORMAL textscale .24 textaligny 12 forecolor .88 .86 .79 1 textstyle ITEM_TEXTSTYLE_SHADOWED }
 itemDef {
  name "return_launcher" visible 1 rect 157.703 272.901 204.785 29.586 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
  text "RETURN TO LAUNCHER" textfont UI_FONT_NORMAL textscale .3 textalignx 8 textaligny 20
  forecolor .84 .80 .67 1 textstyle ITEM_TEXTSTYLE_SHADOWED 
  mouseEnter { play "mouse_over"; setitemcolor return_launcher backcolor .68 .49 .17 .26; setitemcolor return_launcher bordercolor .85 .66 .3 .85; }
  mouseExit { setitemcolor return_launcher backcolor .68 .49 .17 0; setitemcolor return_launcher bordercolor .85 .66 .3 0; }
  action { play "mouse_click"; exec "quit"; }
 }
 itemDef {
  name "cancel_join" visible 1 rect 373.971 272.901 101.435 29.586 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
