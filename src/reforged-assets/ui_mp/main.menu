 itemDef {
  name "join" visible 1 rect 419.139 197.407 177.225 28.565 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
  text "JOIN REFORGED SERVER" textfont UI_FONT_NORMAL textscale .3 textalignx 8 textaligny 20
  forecolor .84 .80 .67 1 textstyle ITEM_TEXTSTYLE_SHADOWED dvarTest "cl_ingame" showDvar { "0" }
  mouseEnter { play "mouse_over"; setitemcolor join backcolor .68 .49 .17 .26; setitemcolor join bordercolor .85 .66 .3 .85; }
  mouseExit { setitemcolor join backcolor .68 .49 .17 0; setitemcolor join bordercolor .85 .66 .3 0; }
  action { play "mouse_click"; open rfg_launcher_join; }
 }
 itemDef {
  name "resume" visible 1 rect 419.139 197.407 177.225 28.565 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
  text "RETURN TO BATTLE" textfont UI_FONT_NORMAL textscale .3 textalignx 8 textaligny 20
  forecolor .84 .80 .67 1 textstyle ITEM_TEXTSTYLE_SHADOWED dvarTest "cl_ingame" showDvar { "1" }
  mouseEnter { play "mouse_over"; setitemcolor resume backcolor .68 .49 .17 .26; setitemcolor resume bordercolor .85 .66 .3 .85; }
  mouseExit { setitemcolor resume backcolor .68 .49 .17 0; setitemcolor resume bordercolor .85 .66 .3 0; }
  action { play "mouse_click"; close main; }
 }
 itemDef {
  name "profile" visible 1 rect 419.139 229.033 177.225 28.565 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
  text "SELECT PROFILE" textfont UI_FONT_NORMAL textscale .3 textalignx 8 textaligny 20
  forecolor .84 .80 .67 1 textstyle ITEM_TEXTSTYLE_SHADOWED dvarTest "cl_ingame" showDvar { "0" }
  mouseEnter { play "mouse_over"; setitemcolor profile backcolor .68 .49 .17 .26; setitemcolor profile bordercolor .85 .66 .3 .85; }
  mouseExit { setitemcolor profile backcolor .68 .49 .17 0; setitemcolor profile bordercolor .85 .66 .3 0; }
  action { play "mouse_click"; setdvar ui_playerProfileAlreadyChosen 0; open player_profile; }
 }
 itemDef {
  name "profile_ingame" visible 1 rect 419.139 229.033 177.225 28.565 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
  text "SELECT PROFILE" textfont UI_FONT_NORMAL textscale .3 textalignx 8 textaligny 20
  forecolor .84 .80 .67 1 textstyle ITEM_TEXTSTYLE_SHADOWED dvarTest "cl_ingame" showDvar { "1" }
  mouseEnter { play "mouse_over"; setitemcolor profile_ingame backcolor .68 .49 .17 .26; setitemcolor profile_ingame bordercolor .85 .66 .3 .85; }
  mouseExit { setitemcolor profile_ingame backcolor .68 .49 .17 0; setitemcolor profile_ingame bordercolor .85 .66 .3 0; }
  action { play "mouse_click"; open player_profile_ingame_warning; }
 }
 itemDef {
  name "multiplayer" visible 1 rect 419.139 260.659 177.225 28.565 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
  text "MULTIPLAYER OPTIONS" textfont UI_FONT_NORMAL textscale .3 textalignx 8 textaligny 20
  forecolor .84 .80 .67 1 textstyle ITEM_TEXTSTYLE_SHADOWED 
  mouseEnter { play "mouse_over"; setitemcolor multiplayer backcolor .68 .49 .17 .26; setitemcolor multiplayer bordercolor .85 .66 .3 .85; }
  mouseExit { setitemcolor multiplayer backcolor .68 .49 .17 0; setitemcolor multiplayer bordercolor .85 .66 .3 0; }
  action { play "mouse_click"; close mods_menu; open options_multi; }
 }
 itemDef {
  name "settings" visible 1 rect 419.139 292.285 177.225 28.565 4 4 type ITEM_TYPE_BUTTON
  style WINDOW_STYLE_FILLED backcolor .68 .49 .17 0 border 1 bordersize .6 bordercolor .85 .66 .3 0
  text "OPTIONS" textfont UI_FONT_NORMAL textscale .3 textalignx 8 textaligny 20
