  mouseEnter { play "mouse_over"; setitemcolor settings backcolor .68 .49 .17 .26; setitemcolor settings bordercolor .85 .66 .3 .85; }
  mouseExit { setitemcolor settings backcolor .68 .49 .17 0; setitemcolor settings bordercolor .85 .66 .3 0; }
  action { play "mouse_click"; close mods_menu; close main_text; open options_menu; }
