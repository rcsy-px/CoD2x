#include "ui/menudef.h"

#define TEXT_ON_BG_STYLE    3

{
    menuDef
    {
        name "options_menu"
        fullScreen 0
        rect 0 0 640 480
        focusColor 1 .84 .42 1
        soundloop ""

        onOpen
        {
            

            
            setdvar ui_background "rfg_mnbg";
            setdvar ui_logo_show "0";
            setdvar ui_version_show "0";
            setdvar ui_separator_show "0";
            setdvar ui_background_gradient_show "0";
            setdvar g_reloading "0";
        }
        onClose
        {
            open main_text;
            close options_look;
            close options_move;
            close options_shoot;
            close options_misc;
            close options_graphics;
            close options_sound;
            close options_game;
            close options_view;
            close options_defaults;
            close options_driverinfo;
            close options_credits;
            close options_multi;
            close options_graphics_defaults;
            close options_graphics_texture;
            close options_control_defaults;
            close options_voice;
            close options_multi;
            close options_zpam;
        }
        onESC
        {
            open main_text;
            close options_menu;
        }



        itemDef { name "rfg_settings_panel" decoration visible 1 rect 20 49 350 371 style WINDOW_STYLE_SHADER background "white" forecolor 0 0 0 .68 }
itemDef { name "rfg_settings_rule" decoration visible 1 rect 20 49 350 1 style WINDOW_STYLE_SHADER background "white" forecolor .74 .57 .27 .75 }
itemDef { name "rfg_settings_top" decoration visible 1 rect 0 0 640 53 4 4 style WINDOW_STYLE_SHADER background "white" forecolor 0 0 0 .32 }
