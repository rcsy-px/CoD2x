itemDef { name "rfg_settings_bottomline" decoration visible 1 rect 0 428 640 .6 4 4 style WINDOW_STYLE_SHADER background "white" forecolor .74 .57 .27 .6 }
itemDef { name "rfg_settings_logo" decoration visible 1 rect 425 55 144 72 style WINDOW_STYLE_SHADER background "rfg_mnlg" forecolor 1 1 1 1 }
